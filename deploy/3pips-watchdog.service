[Unit]
Description=3pips host watchdog
After=network-online.target docker.service
Wants=network-online.target docker.service

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/3pips
EnvironmentFile=-/etc/3pips/3pips.env
ExecStart=/usr/bin/python3 /opt/3pips/scripts/server_watchdog.py --project-root /opt/3pips

