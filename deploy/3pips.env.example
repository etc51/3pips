# Copy to /etc/3pips/3pips.env on the Ubuntu server.
# Do not commit a real token.
#
# If the token is already configured on the server, leave this file as a reference only.
TBANK_TOKEN=

# Optional GigaChat analyst credentials.
# Use either a base64 auth key or client id / client secret pair.
GIGACHAT_AUTH_KEY=
# GIGACHAT_CLIENT_ID=
# GIGACHAT_CLIENT_SECRET=
# GIGACHAT_MODEL=GigaChat
# GIGACHAT_SCOPE=GIGACHAT_API_PERS
# GIGACHAT_VERIFY_SSL=0

# Docker auto-update.
# The server will fetch GitHub and rebuild containers automatically.
AUTOUPDATE_REMOTE=origin
AUTOUPDATE_BRANCH=main
AUTOUPDATE_REQUIRE_IDLE=1
AUTOUPDATE_RUN_NAME=v7_live_20260525

PYTHONUNBUFFERED=1
TZ=Europe/Moscow
