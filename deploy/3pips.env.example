# Copy to /etc/3pips/3pips.env on the Ubuntu server.
# Do not commit a real token.
#
# If the token is already configured on the server, leave this file as a reference only.
TBANK_TOKEN=

# Optional OpenAI analyst credentials.
# Can be provided via env or secrets/openai_api_key.txt.
OPENAI_API_KEY=
# OPENAI_API_KEY_FILE=/opt/3pips/secrets/openai_api_key.txt
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4.1-mini
# OPENAI_TIMEOUT_SEC=120

# Docker auto-update.
# The server will fetch GitHub and rebuild containers automatically.
AUTOUPDATE_REMOTE=origin
AUTOUPDATE_BRANCH=main
AUTOUPDATE_REQUIRE_IDLE=1
AUTOUPDATE_RUN_NAME=v7_live_20260525

# Daily raw archive mailer.
# Set ARCHIVE_EMAIL_ENABLED=1 only after SMTP password is present.
ARCHIVE_EMAIL_ENABLED=0
ARCHIVE_EMAIL_TO=etc00051@yandex.ru
ARCHIVE_EMAIL_FROM=etc00051@yandex.ru
ARCHIVE_SMTP_HOST=smtp.yandex.ru
ARCHIVE_SMTP_PORT=465
ARCHIVE_SMTP_USER=etc00051@yandex.ru
# ARCHIVE_SMTP_PASSWORD_FILE=/opt/3pips/secrets/archive_smtp_password.txt
ARCHIVE_SMTP_USE_SSL=1
ARCHIVE_SMTP_STARTTLS=0
ARCHIVE_RUN_NAME=v7_live_20260525
ARCHIVE_KEEP_DAYS=14
ARCHIVE_DAILY_TIME=23:59
ARCHIVE_LOOP_CHECK_SEC=30

PYTHONUNBUFFERED=1
TZ=Europe/Moscow
